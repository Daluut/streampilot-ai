# StreamPilot AI — server-side configuration template.
# Copy this file to `.env.local` and fill in the values you need.
# Every value is OPTIONAL: the app runs fully in Demo mode without any of them.
# Never commit `.env.local`. These variables are read only on the server and are
# never sent to the browser.

# --- AI analysis (optional) -------------------------------------------------
# Without a key, StreamPilot uses its deterministic local rules engine.
# When set, the last analysis batch (usernames removed) is sent to Anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model used for AI analysis.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Twitch chat (optional) -------------------------------------------------
# Chat is read over Twitch IRC via WebSocket. By default the app connects
# anonymously (read-only, no credentials needed).
# Only set these if you want to authenticate with a user access token that has
# the `chat:read` scope. Keep the token server-side; never expose it to the browser.
TWITCH_OAUTH_TOKEN=
TWITCH_LOGIN=

# Twitch IRC WebSocket endpoint. Leave as default unless you run a test server.
TWITCH_IRC_URL=wss://irc-ws.chat.twitch.tv:443
